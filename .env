# E.g. http://localhost:3000/ollama for Open WebUI or http://localhost:11434 for pure Ollama (OPENWEBUI_SECRET_KEY not necessary)

CUSTOM_BASE_URL="https://chat.ipb-halle.de/ollama"
# OPENWEBUI_SECRET_KEY="your_secret_key_here or in .bashrc"
SSL_CERT_FILE=/etc/ssl/servercert/ipb_ca.bis2026.pem
# SSL_CERT_DIR=/etc/ssl/servercert


# The HTTP client used by LangChain is httpx. By default, it uses certifi's root certificate store, which is
# installed as httpx's dependency. Certifi does not include the IPB-CA. To override this behaviour set the SSL_CERT_FILE
# environment variable, see https://www.python-httpx.org/advanced/ssl/#working-with-ssl_cert_file-and-ssl_cert_dir for
# details.
# To figure out the correct cert file of your operating system run 'python3 -c "import certifi; print(certifi.where())"'
# **outside a venv**.
#
# Location in Debian 13:
# SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
# Alternatively, you can point it to the certificate file of the IPB-CA:
#SSL_CERT_FILE=/etc/ssl/servercert/ipb_ca.bis2026.pem